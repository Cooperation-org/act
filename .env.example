# copy to .env (mode 600); systemd: EnvironmentFile=
ACT_SECRET_KEY=change-me
# Apps this deployment serves (comma list): campaigns, letters, blog, people, artifacts (Story Kit).
# cooperation.org: letters. raisethevoices: campaigns,blog,people. Jreas Coop: campaigns,blog,people.
ACT_APPS=campaigns,letters,blog,people
# Single-org site: the org slug this deployment IS (home = that org's page; its campaigns,
# posts and people only). Unset = platform mode listing every org's published campaigns.
ACT_SITE_ORG=
ACT_DEBUG=0
ACT_ALLOWED_HOSTS=act.raisethevoices.org
# Postgres on VM 100 (leave unset for local sqlite dev)
ACT_PG_DB=
ACT_PG_USER=
ACT_PG_PASSWORD=
ACT_PG_HOST=10.0.0.100
ACT_PG_PORT=5432
# LinkedTrust SSO — set all three to enable (register client at live.linkedtrust.us first)
LINKEDTRUST_CLIENT_ID=
LINKEDTRUST_CLIENT_SECRET=
ACT_PUBLIC_URL=https://act.raisethevoices.org
# LinkedTrust: testimonials are signed as LinkedClaims (same client-credential pattern as workers.vc).
# Without LT_CLIENT_ID/SECRET act refuses to sign (a claim with no issuer can never be edited).
LT_API=https://live.linkedtrust.us
LT_EMBED=https://demos.linkedtrust.us/embed
LT_CLIENT_ID=
LT_CLIENT_SECRET=
# Path prefix when served under a subpath, e.g. /act (empty at a domain root)
ACT_BASE_PATH=
# gunicorn strips this prefix from incoming paths; set to the same value as ACT_BASE_PATH
SCRIPT_NAME=
# Outgoing mail for signature confirmations (Migadu SMTP). Unset EMAIL_HOST = no mail sent, attempts logged.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# Story Kit files: S3-compatible bucket (Backblaze B2). Unset = files in media/.
ACT_STORAGE_BUCKET=
ACT_STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
ACT_STORAGE_KEY=
ACT_STORAGE_SECRET=
ACT_STORAGE_REGION=us-east-005
# 1 (default) = time-limited signed links (private bucket). 0 + PUBLIC_HOST only for a public bucket.
ACT_STORAGE_SIGNED_URLS=1
ACT_STORAGE_PUBLIC_HOST=
# Story Kit email intake: one mailbox (Migadu), one address per org (manage.py set_intake_address)
ACT_INTAKE_IMAP_HOST=imap.migadu.com
ACT_INTAKE_IMAP_USER=
ACT_INTAKE_IMAP_PASSWORD=
# Optional: Drive API key (adds owner + photo dates). Unset = public folder view.
ACT_GOOGLE_API_KEY=
# Optional: AI helper (collection -> story draft). Unset = button hidden.
ANTHROPIC_API_KEY=
ACT_AI_MODEL=claude-sonnet-5-5
# Fallback when Anthropic is unset or fails (text only, no photos)
MINIMAX_API_KEY=
ACT_MINIMAX_MODEL=MiniMax-M3
# Live demo (/demo/): visitors get their own copy of this org; unset = off
ACT_DEMO_ORG=
# Campaign video clip size limit (MB); clips use the same storage as photos
ACT_VIDEO_MAX_MB=100
