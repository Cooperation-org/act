# copy to .env (mode 600); systemd: EnvironmentFile=
ACT_SECRET_KEY=change-me
# Apps this deployment serves (comma list): campaigns, letters, blog, people.
# cooperation.org: letters. raisethevoices: campaigns,blog,people. Jreas Coop: campaigns,blog,people.
ACT_APPS=campaigns,letters,blog,people
# Single-org site: the org slug this deployment IS (home = that org's page; its campaigns,
# posts and people only). Unset = platform mode listing every org's published campaigns.
ACT_SITE_ORG=
ACT_DEBUG=0
ACT_ALLOWED_HOSTS=act.raisethevoices.org
# Postgres on VM 100 (leave unset for local sqlite dev)
ACT_PG_DB=
ACT_PG_USER=
ACT_PG_PASSWORD=
ACT_PG_HOST=10.0.0.100
ACT_PG_PORT=5432
# LinkedTrust SSO — set all three to enable (register client at live.linkedtrust.us first)
LINKEDTRUST_CLIENT_ID=
LINKEDTRUST_CLIENT_SECRET=
ACT_PUBLIC_URL=https://act.raisethevoices.org
# LinkedTrust: testimonials are signed as LinkedClaims (same client-credential pattern as workers.vc).
# Without LT_CLIENT_ID/SECRET act refuses to sign (a claim with no issuer can never be edited).
LT_API=https://live.linkedtrust.us
LT_EMBED=https://demos.linkedtrust.us/embed
LT_CLIENT_ID=
LT_CLIENT_SECRET=
# Path prefix when served under a subpath, e.g. /act (empty at a domain root)
ACT_BASE_PATH=
# gunicorn strips this prefix from incoming paths; set to the same value as ACT_BASE_PATH
SCRIPT_NAME=
# Outgoing mail for signature confirmations (Migadu SMTP). Unset EMAIL_HOST = no mail sent, attempts logged.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
